# Host ports for compose.yaml. Project rule (CLAUDE.md): never hardcode ports.
# On the deploy host, copy this file to .env:  cp .env.example .env
# No secrets here. Secrets live only encrypted in secrets/*.enc.yaml (SOPS/age).
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000

# Required secrets, not set in this file: GRAFANA_ADMIN_PASSWORD, OPENSEARCH_MONITOR_PASSWORD.
# `make secrets` decrypts them from secrets/observability.enc.yaml into .env.secrets at deploy time.

# Logstash with the OpenSearch output plugin (Lab 5), pinned by tag and digest.
# 8.9.0 (2023-08-10) is the newest tag published; recorded on the deploy host on 2026-11-10.
LOGSTASH_IMAGE=opensearchproject/logstash-oss-with-opensearch-output-plugin:8.9.0@sha256:43b0cdaf26edca812a9eafb684ae6101d8f2fd27165345737c39c04a6c7430eb
